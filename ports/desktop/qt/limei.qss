QWidget {
    color: #ada9a3;
    background: #101010;
    selection-color: #c0bbb3;
    selection-background-color: #292724;
}

QMainWindow,
QDialog {
    background: #101010;
}

QToolBar,
QMenuBar,
QStatusBar,
QHeaderView::section {
    background: #171717;
    border: 0;
}

QStatusBar {
    color: #837f78;
}

QMenu,
QAbstractItemView {
    background: #171717;
    border: 1px solid #393632;
    outline: 0;
}

QMenu::item:selected,
QAbstractItemView::item:selected,
QTabBar::tab:selected {
    color: #c0bbb3;
    background: #302d29;
}

QPushButton,
QToolButton,
QComboBox,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QTabBar::tab {
    color: #ada9a3;
    background: #171717;
    border: 1px solid #393632;
    border-radius: 4px;
    padding: 5px 7px;
}

QPushButton:hover,
QToolButton:hover,
QComboBox:hover,
QTabBar::tab:hover {
    background: #302d29;
    border-color: #9a897c;
}

QPushButton:focus,
QToolButton:focus,
QComboBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus {
    border-color: #9a897c;
}

QPushButton:disabled,
QToolButton:disabled,
QLineEdit:disabled {
    color: #64605a;
    border-color: #393632;
}

QProgressBar {
    color: #ada9a3;
    background: #171717;
    border: 1px solid #393632;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background: #768569;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #101010;
    border: 0;
}

QScrollBar::handle {
    background: #393632;
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #837f78;
}

QToolTip {
    color: #ada9a3;
    background: #171717;
    border: 1px solid #393632;
}
