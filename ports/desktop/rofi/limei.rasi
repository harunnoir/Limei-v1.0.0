* {
    background:      #101010;
    background-alt:  #171717;
    selected:        #302d29;
    border:          #393632;
    foreground:      #ada9a3;
    muted:           #837f78;
    focus:           #9a897c;
    navigation:      #918862;
    urgent:          #9a7477;

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 42%;
    background-color: @background;
    border: 1px;
    border-color: @border;
    border-radius: 5px;
    padding: 12px;
}

mainbox {
    spacing: 10px;
}

inputbar {
    background-color: @background-alt;
    border: 1px;
    border-color: @border;
    border-radius: 4px;
    padding: 9px 11px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @focus;
    padding: 0 8px 0 0;
}

entry {
    placeholder-color: @muted;
}

listview {
    lines: 10;
    columns: 1;
    spacing: 3px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    border-radius: 4px;
}

element selected {
    background-color: @selected;
    text-color: #c0bbb3;
}

element selected element-icon {
    text-color: @navigation;
}

element urgent {
    text-color: @urgent;
}

element-icon {
    size: 20px;
    margin: 0 9px 0 0;
}
